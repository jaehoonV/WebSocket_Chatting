<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WebSocket Chatting</title>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.3.1/socket.io.js"></script>
    <script type="text/javascript" src="/script/chat.js" defer></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <link rel="stylesheet" href="/stylesheets/chat.css">
</head>

<body>
    <div class="app-shell">
        <div class="bg-orb bg-orb-1"></div>
        <div class="bg-orb bg-orb-2"></div>

        <div id="input_name_div" class="entry-card">
            <div class="entry-card__badge">Realtime Chat</div>
            <h1 class="entry-card__title">채팅에 입장하기</h1>
            <p class="entry-card__desc">이름을 입력하고 채팅방을 선택해 대화를 시작하세요.</p>

            <div class="entry-form">
                <input id="input_name" autocomplete="off" placeholder="이름을 입력하세요" />
                <button type="button" id="nameSave_btn" onclick="nameSave()">입장</button>
            </div>
        </div>

        <div id="chat_container" class="chat-layout">
            <aside class="sidebar">
                <div class="panel brand-panel">
                    <div class="panel-label">Chat Room</div>
                    <h2 class="brand-title">WebSocket Chat</h2>
                </div>

                <div class="panel room-panel">
                    <div class="panel-header">
                        <span class="panel-label">현재 방</span>
                        <span id="room-badge" class="room-badge">미선택</span>
                    </div>

                    <div class="room-stats">
                        <div class="stat-box">
                            <span class="stat-label">방 이름</span>
                            <strong id="room-name">채팅방을 선택하세요</strong>
                        </div>
                        <div class="stat-box">
                            <span class="stat-label">참여자 수</span>
                            <strong id="user-num">0명</strong>
                        </div>
                    </div>

                    <div class="room-members">
                        <span class="stat-label">현재 방 참여자</span>
                        <div id="user-list" class="member-list-empty">아직 참여자가 없습니다.</div>
                    </div>
                </div>

                <div class="panel select-panel">
                    <label class="panel-label" for="selectBox">채팅방 선택</label>
                    <div class="select-wrap">
                        <select id="selectBox" onchange="changeSelection()">
                            <option selected disabled>채팅방을 선택하세요</option>
                            <option>Room1</option>
                            <option>Room2</option>
                            <option>Room3</option>
                            <option>Room4</option>
                        </select>
                    </div>
                </div>

                <div class="panel connected-panel" id="connected-user-box">
                    <div class="panel-header">
                        <span class="panel-label">전체 접속자</span>
                        <span id="connected-user-count" class="user-count">0명</span>
                    </div>
                    <ul id="connected-user-list"></ul>
                </div>
            </aside>

            <main class="chat-main">
                <div class="chat-wrapper" id="chat-wrapper">
                    <div id="messages"></div>

                    <div id="chat_input_container">
                        <textarea
                            spellcheck="false"
                            name="chat_input"
                            id="chat_input"
                            placeholder="메시지를 입력하세요 (Shift/Alt+Enter로 줄바꿈)"
                        ></textarea>
                        <div id="send_btn_container">
                            <button id="send_btn" onclick="send()" aria-label="메시지 전송">
                                <ion-icon name="send"></ion-icon>
                            </button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>

</html>